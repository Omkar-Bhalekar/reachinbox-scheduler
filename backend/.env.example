# ─── Server ─────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://reachinbox:reachinbox123@localhost:5432/reachinbox"

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Elasticsearch ───────────────────────────────────────────────────────
ELASTICSEARCH_URL="http://localhost:9200"

# ─── Ethereal Email (fake SMTP) ─────────────────────────────────────────
# Leave blank for automatic selection: Ethereal locally, Resend on Railway.
# Set explicitly to "ethereal" or "resend" only to override that behavior.
# Leave both empty to auto-provision a fresh Ethereal test account on boot,
# or paste credentials from https://ethereal.email to pin one.
EMAIL_PROVIDER=""
ETHEREAL_USER=""
ETHEREAL_PASS=""

# ─── Resend Email (Railway production) ──────────────────────────────────
# Railway default: EMAIL_PROVIDER defaults to "resend" when RAILWAY_ENVIRONMENT
# is present. RESEND_FROM_EMAIL must be a Resend-verified address/domain.
# The compose-form sender is used as Reply-To, while this verified address is
# the actual From address sent by Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ReachInbox <notifications@your-verified-domain.com>"

# ─── Slack OAuth (create a Slack app -> OAuth & Permissions -> add the
# incoming-webhook and chat:write scopes -> use its Client ID/Secret here) ─
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/auth/slack/callback"

# ─── Rate limiting & concurrency ────────────────────────────────────────
MAX_EMAILS_PER_HOUR_PER_SENDER=200
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
